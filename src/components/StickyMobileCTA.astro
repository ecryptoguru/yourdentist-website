---
import { clinicInfo } from '@/lib/data';
---

<div
  id="sticky-mobile-cta"
  class="fixed bottom-0 left-0 right-0 z-40 sm:hidden translate-y-full opacity-0 transition-all duration-300 ease-out"
>
  <div class="bg-white dark:bg-warm-800 border-t border-slate-200 dark:border-warm-600 shadow-[0_-4px_20px_rgba(0,0,0,0.1)] px-4 py-3 flex items-center gap-3">
    <a
      href={clinicInfo.whatsapp}
      target="_blank"
      rel="noopener noreferrer"
      class="flex-1 flex items-center justify-center gap-2 bg-teal-600 hover:bg-teal-700 text-white rounded-xl py-3 font-medium text-sm transition-colors touch-manipulation"
    >
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
      Book Appointment
    </a>
    <a
      href={clinicInfo.phoneLink}
      class="flex items-center justify-center gap-2 bg-slate-100 dark:bg-warm-700 hover:bg-slate-200 dark:hover:bg-warm-600 text-slate-800 dark:text-warm-200 rounded-xl py-3 px-4 font-medium text-sm transition-colors touch-manipulation"
    >
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
      Call
    </a>
    <button
      id="sticky-cta-dismiss"
      type="button"
      aria-label="Dismiss booking bar"
      class="w-9 h-9 flex items-center justify-center text-slate-500 dark:text-warm-400 hover:text-slate-600 dark:hover:text-warm-300 rounded-lg transition-colors"
    >
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>
    </button>
  </div>
</div>

<script>
  const cta = document.getElementById('sticky-mobile-cta');
  const dismissBtn = document.getElementById('sticky-cta-dismiss');
  let dismissed = sessionStorage.getItem('yd-cta-dismissed') === '1';

  const update = () => {
    if (!cta || dismissed) return;
    if (window.scrollY > 600) {
      cta.classList.remove('translate-y-full', 'opacity-0');
    } else {
      cta.classList.add('translate-y-full', 'opacity-0');
    }
  };

  if (cta && !dismissed) {
    update();
    window.addEventListener('scroll', update, { passive: true });
  }

  dismissBtn?.addEventListener('click', () => {
    dismissed = true;
    sessionStorage.setItem('yd-cta-dismissed', '1');
    cta?.classList.add('translate-y-full', 'opacity-0');
    window.removeEventListener('scroll', update);
  });
</script>

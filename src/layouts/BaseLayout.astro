---
import '../styles/global.css';
import { clinicInfo, doctor, faqItems, serviceList } from '@/lib/data';
import { SITE_URL } from '@/lib/site';
import { jsonLd } from '@/lib/json-ld';
import EmergencyBanner from '@/components/EmergencyBanner.astro';
import ScrollToTop from '@/components/ScrollToTop.astro';
import StickyMobileCTA from '@/components/StickyMobileCTA.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  includeGlobalFaq?: boolean;
  /** Emit a <link rel="preload"> for the homepage hero image. Use on the homepage only. */
  preloadHero?: boolean;
  /** Honest freshness date (YYYY-MM-DD) for the WebPage schema — omit when unknown. */
  lastReviewed?: string;
}

const {
  title = 'Best Dental Clinic in Bhubaneswar | YourDentist Laser Dental Clinic',
  description = 'Top-rated dental clinic in Bhubaneswar led by Dr. Arpita Dash. Painless root canal, braces, implants, laser dentistry & smile designing. 5,000+ happy patients. Book today!',
  ogImage = `${SITE_URL}/images/og/default.jpg`,
  canonical,
  noindex = false,
  type = 'website',
  includeGlobalFaq = false,
  preloadHero = false,
  lastReviewed,
} = Astro.props;

const canonicalUrl = canonical || new URL(Astro.url.pathname, SITE_URL).href;

const dentistSchema = {
  '@context': 'https://schema.org',
  '@type': ['Dentist', 'MedicalBusiness', 'LocalBusiness'],
  name: 'YourDentist Laser Dental Clinic',
  description: 'Advanced laser dental clinic in Bhubaneswar offering root canal treatment, orthodontics, dental implants, aesthetic dentistry, and painless dental care.',
  image: `${SITE_URL}/images/clinic.jpg`,
  logo: `${SITE_URL}/images/clinic.jpg`,
  '@id': SITE_URL,
  url: SITE_URL,
  telephone: '+91 7064719630',
  email: 'yourdentist27@gmail.com',
  priceRange: '$$',
  currenciesAccepted: 'INR',
  paymentAccepted: 'Cash, Credit Card, Debit Card, UPI',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Plot 190/2972, E Canal Rd, beside SHIBANI ENCLAVE, Bomikhal',
    addressLocality: 'Bhubaneswar',
    addressRegion: 'Odisha',
    postalCode: '751010',
    addressCountry: 'IN',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 20.2858073,
    longitude: 85.8612643,
  },
  areaServed: [
    { '@type': 'City', name: 'Bhubaneswar' },
    { '@type': 'City', name: 'Cuttack' },
    { '@type': 'AdministrativeArea', name: 'Odisha' },
    { '@type': 'AdministrativeArea', name: 'Bomikhal' },
  ],
  knowsLanguage: ['en', 'hi', 'or'],
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'reservations',
      telephone: '+91 7064719630',
      areaServed: 'IN',
      availableLanguage: ['English', 'Hindi', 'Odia'],
    },
    {
      '@type': 'ContactPoint',
      contactType: 'emergency',
      telephone: '+91 7064719630',
      areaServed: 'IN',
      availableLanguage: ['English', 'Hindi', 'Odia'],
    },
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Dental Services in Bhubaneswar',
    itemListElement: serviceList.map((s) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'MedicalTherapy',
        name: s.title,
        url: `${SITE_URL}/services/${s.slug}/`,
      },
    })),
  },
  medicalSpecialty: ['Dentistry', 'Orthodontics', 'Endodontics', 'CosmeticDentistry'],
  knowsAbout: [
    'Root Canal Treatment',
    'Orthodontic Treatment',
    'Dental Implants',
    'Laser Dentistry',
    'Aesthetic Dentistry',
    'Smile Designing',
    'Teeth Whitening',
    'Crown and Bridge',
    'Paediatric Dentistry',
  ],
  availableService: serviceList.map((s) => ({
    '@type': 'MedicalTherapy',
    name: s.title,
    url: `${SITE_URL}/services/${s.slug}/`,
  })),
  hasMap: 'https://maps.app.goo.gl/V4AjCU2EzFhuXABy6',
  hasDriveThroughService: false,
  potentialAction: {
    '@type': 'ScheduleAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${SITE_URL}/#appointment`,
      actionPlatform: ['https://schema.org/WebSite', 'https://schema.org/DesktopWebPlatform', 'https://schema.org/MobileWebPlatform'],
    },
    resultSpecification: {
      '@type': 'Reservation',
      name: 'Dental Appointment',
    },
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '10:00',
      closes: '13:30',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '17:00',
      closes: '20:30',
    },
  ],
  sameAs: [
    'https://maps.app.goo.gl/V4AjCU2EzFhuXABy6',
    'https://www.facebook.com/yourdentistpro',
    'https://www.instagram.com/yourdentistpro',
    'https://youtube.com/@yourdentistclinic',
    'https://twitter.com/yourdentistpro',
  ],
  founder: {
    '@type': 'Person',
    name: 'Dr. Arpita Dash',
    jobTitle: 'Dental Surgeon & Smile Specialist',
  },
  employee: {
    '@type': 'Person',
    name: 'Dr. Arpita Dash',
    jobTitle: 'Dental Surgeon & Smile Specialist',
  },
};

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE_URL}/#person`,
  name: 'Dr. Arpita Dash',
  jobTitle: 'Dental Surgeon & Smile Specialist',
  worksFor: {
    '@type': 'Dentist',
    name: 'YourDentist Laser Dental Clinic',
    url: SITE_URL,
  },
  image: `${SITE_URL}/images/gallery/Image-1.jpeg`,
  url: `${SITE_URL}/about/`,
  knowsAbout: doctor.specializations,
  alumniOf: {
    '@type': 'EducationalOrganization',
    name: 'Institute of Dental Sciences, SOA University',
  },
  award: '10+ Years of Dental Excellence',
  description: `Dr. Arpita Dash is a dental surgeon with ${doctor.experience} years of experience in Bhubaneswar, specializing in root canal treatment, orthodontics, dental implants, and aesthetic dentistry.`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Bhubaneswar',
    addressRegion: 'Odisha',
    addressCountry: 'IN',
  },
};

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE_URL}/#organization`,
  name: 'YourDentist Laser Dental Clinic',
  url: SITE_URL,
  logo: `${SITE_URL}/images/clinic.jpg`,
  founder: { '@type': 'Person', name: 'Dr. Arpita Dash' },
  foundingDate: '2014',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Plot 190/2972, E Canal Rd, beside SHIBANI ENCLAVE, Bomikhal',
    addressLocality: 'Bhubaneswar',
    addressRegion: 'Odisha',
    postalCode: '751010',
    addressCountry: 'IN',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    telephone: '+91 7064719630',
    email: 'yourdentist27@gmail.com',
    areaServed: 'IN',
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description: description,
  url: canonicalUrl,
  isPartOf: { '@type': 'WebSite', name: 'YourDentist Laser Dental Clinic', url: SITE_URL },
  ...(lastReviewed && { lastReviewed }),
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['h1', '.speakable-summary'],
  },
};
---

<!doctype html>
<html lang="en-IN" class="no-js h-full antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="theme-color" content="#0d9488" id="meta-theme-color" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="best dental clinic in Bhubaneswar, dentist near me Bhubaneswar, laser dental clinic Bhubaneswar, root canal treatment Bhubaneswar, braces Bhubaneswar, dental implants Bhubaneswar, painless dentistry Odisha, smile designing Bhubaneswar, teeth whitening Bhubaneswar, orthodontist Bhubaneswar, Dr. Arpita Dash, dental clinic Bomikhal" />
    <meta name="author" content="Dr. Arpita Dash" />
    <meta name="geo.region" content="IN-OR" />
    <meta name="geo.placename" content="Bhubaneswar, Odisha" />
    <meta name="geo.position" content="20.2858073;85.8612643" />
    <meta name="ICBM" content="20.2858073, 85.8612643" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en-IN" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="YourDentist Laser Dental Clinic" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="YourDentist Laser Dental Clinic - Dr. Arpita Dash" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts: self-hosted woff2 via @font-face in global.css -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/Lora-600-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/SourceSans3-400-latin.woff2" crossorigin />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Preload hero image for LCP (homepage only) -->
    {preloadHero && <link rel="preload" as="image" href="/images/hero-welcome-1200.webp" fetchpriority="high" />}

    <!-- JSON-LD: Dentist/LocalBusiness -->
    <script type="application/ld+json" set:html={jsonLd(dentistSchema)} />
    <!-- JSON-LD: Person (Dr. Arpita Dash) -->
    <script type="application/ld+json" set:html={jsonLd(personSchema)} />
    <!-- JSON-LD: Organization -->
    <script type="application/ld+json" set:html={jsonLd(orgSchema)} />
    <!-- JSON-LD: FAQPage (only on pages that render the global FAQ section) -->
    {includeGlobalFaq && <script type="application/ld+json" set:html={jsonLd(faqSchema)} />}
    <!-- JSON-LD: WebPage -->
    <script type="application/ld+json" set:html={jsonLd(webPageSchema)} />
    <slot name="head" />
    <script is:inline>
      (function () {
        const html = document.documentElement;
        html.classList.remove('no-js');
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const isDark = stored === 'dark' || (!stored && prefersDark);
        if (isDark) html.classList.add('dark');
        if (sessionStorage.getItem('yd-emergency-dismissed')) html.classList.add('no-emergency');
        const meta = document.getElementById('meta-theme-color');
        if (meta) meta.setAttribute('content', isDark ? '#1c1917' : '#0d9488');
      })();
    </script>
  </head>
  <body class="min-h-full flex flex-col font-sans">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-60 focus:bg-teal-700 focus:text-white focus:px-4 focus:py-2 focus:rounded-lg focus:text-sm focus:font-medium"
    >
      Skip to main content
    </a>

    <!-- Scroll progress bar -->
    <div class="scroll-progress" id="scroll-progress"></div>

    <EmergencyBanner />
    <div id="main-content" class="contents">
      <slot />
    </div>
    <ScrollToTop />
    <StickyMobileCTA />

    <!-- Global scroll reveal script -->
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0, rootMargin: '0px' }
      );

      document.querySelectorAll('.reveal, .stagger-item, .reveal-up').forEach((el) => {
        observer.observe(el);
      });

      // Scroll progress bar
      const progressBar = document.getElementById('scroll-progress');
      if (progressBar) {
        let ticking = false;
        window.addEventListener('scroll', () => {
          if (!ticking) {
            requestAnimationFrame(() => {
              const scrollTop = window.scrollY;
              const docHeight = document.documentElement.scrollHeight - window.innerHeight;
              const scrollPercent = (scrollTop / docHeight) * 100;
              progressBar.style.width = scrollPercent + '%';
              ticking = false;
            });
            ticking = true;
          }
        }, { passive: true });
      }
    </script>
  </body>
</html>

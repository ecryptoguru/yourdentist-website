---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { getCollection, render } from 'astro:content';
import { doctor, clinicInfo } from '@/lib/data';
import { formatDate } from '@/lib/format';
import { parseFaq, countWords, extractToc } from '@/lib/blog-faq';
import { slugifyCategory } from '@/lib/blog-categories';
import { SITE_URL } from '@/lib/site';
import { jsonLd } from '@/lib/json-ld';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
  }));
}

const { slug } = Astro.params;
const posts = await getCollection('blog');
const post = posts.find((p) => p.id === slug);

if (!post) {
  return Astro.redirect('/404');
}

const data = post.data;
const { Content } = await render(post);
const faqs = parseFaq(post.body ?? '');
const wordCount = countWords(post.body ?? '');
const toc = extractToc(post.body ?? '');
const categorySlug = slugifyCategory(data.category);

const relatedPosts = [
  ...posts
    .filter((p) => p.id !== slug && p.data.category === data.category)
    .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()),
  ...posts
    .filter((p) => p.id !== slug && p.data.category !== data.category)
    .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()),
]
  .slice(0, 6)
  .map((p) => ({ id: p.id, ...p.data }));

// Chronological prev/next across the whole blog (next = newer, prev = older).
const chronological = [...posts].sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const postIndex = chronological.findIndex((p) => p.id === slug);
const nextPost = postIndex > 0 ? chronological[postIndex - 1] : undefined;
const prevPost = postIndex < chronological.length - 1 ? chronological[postIndex + 1] : undefined;

const published = data.date.toISOString().slice(0, 10);
const modified = (data.lastUpdated ?? data.date).toISOString().slice(0, 10);
const ogImage = `${SITE_URL}/images/og/${categorySlug}.jpg`;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${SITE_URL}/blog/${slug}/#article`,
  headline: data.title,
  description: data.excerpt,
  image: ogImage,
  datePublished: published,
  dateModified: modified,
  inLanguage: 'en-IN',
  wordCount,
  articleSection: data.category,
  keywords: [data.category, 'dentist Bhubaneswar', 'dental clinic Bhubaneswar', 'Dr. Arpita Dash', 'YourDentist'],
  author: { '@type': 'Person', '@id': `${SITE_URL}/#person`, name: doctor.name, jobTitle: 'Dental Surgeon & Smile Specialist', url: `${SITE_URL}/about/` },
  publisher: { '@type': 'Organization', '@id': `${SITE_URL}/#organization`, name: clinicInfo.name, logo: { '@type': 'ImageObject', url: `${SITE_URL}/images/clinic.jpg` } },
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${SITE_URL}/blog/${slug}/` },
  isPartOf: { '@type': 'Blog', '@id': `${SITE_URL}/blog/#blog`, name: 'YourDentist Dental Health Blog' },
  speakable: { '@type': 'SpeakableSpecification', cssSelector: ['h1', '.speakable-summary'] },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---

<BaseLayout title={`${data.title} | YourDentist Bhubaneswar`} description={data.excerpt} type="article" ogImage={ogImage} lastReviewed={modified}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonLd(articleLd)} />
    {faqs.length > 0 && <script type="application/ld+json" set:html={jsonLd(faqLd)} />}
  </Fragment>
  <Header />
  <main class="flex-1 pt-36">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Blog', href: '/blog/' }, { name: data.title, href: `/blog/${slug}/` }]} />
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
      <article>
        <div class="reveal">
          <div class="aspect-video rounded-xl overflow-hidden mb-8 border border-slate-200/40 dark:border-warm-600 shadow-premium">
            <img
              src={`/images/blog/${categorySlug}.svg`}
              alt={`${data.category} — YourDentist Laser Dental Clinic`}
              width="1200"
              height="675"
              fetchpriority="high"
              class="w-full h-full object-cover"
            />
          </div>
        </div>

        <div class="reveal" style="transition-delay: 0.1s">
          <a href={`/blog/category/${categorySlug}/`} class="inline-block bg-teal-50 dark:bg-teal-900/40 text-teal-700 dark:text-teal-400 border border-teal-100 dark:border-teal-800 mb-4 font-medium text-xs px-3 py-1 rounded-full hover:bg-teal-700 hover:text-white dark:hover:bg-teal-600 dark:hover:text-white hover:border-teal-700 dark:hover:border-teal-600 transition-colors duration-300">{data.category}</a>
          <h1 class="font-heading text-3xl sm:text-4xl font-semibold text-slate-900 dark:text-warm-100 mb-5 tracking-tight leading-[1.15]">{data.title}</h1>
        </div>

        <div class="reveal" style="transition-delay: 0.15s">
          <div class="flex flex-wrap items-center gap-4 mb-8">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-teal-50 dark:bg-teal-900/40 border border-teal-100 dark:border-teal-800 rounded-full flex items-center justify-center">
                <span class="bg-teal-50 dark:bg-teal-900/40 text-teal-700 dark:text-teal-400 text-sm font-bold">AD</span>
              </div>
              <div>
                <p class="font-medium text-slate-900 dark:text-warm-100 text-sm">{doctor.name}</p>
                <p class="text-slate-500 dark:text-warm-400 text-xs">Dental Surgeon & Smile Specialist</p>
              </div>
            </div>
            <div class="w-px h-8 bg-slate-200 dark:bg-warm-600 hidden sm:block"></div>
            <div class="flex items-center gap-3 text-sm text-slate-500 dark:text-warm-400">
              <span class="flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
                {formatDate(data.date, { month: 'long', day: 'numeric', year: 'numeric' })}
              </span>
              {data.lastUpdated && (
                <span class="flex items-center gap-1.5 text-xs text-slate-400 dark:text-warm-500">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56" /><path d="M21 3v6h-6" /></svg>
                  Updated {formatDate(data.lastUpdated, { month: 'short', day: 'numeric', year: 'numeric' })}
                </span>
              )}
              <span class="flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                {data.readTime}
              </span>
            </div>
          </div>
        </div>

        <div class="reveal" style="transition-delay: 0.18s">
          <div class="speakable-summary not-prose bg-teal-50/60 dark:bg-teal-900/20 border-l-4 border-teal-500 dark:border-teal-600 rounded-r-xl px-5 py-4 mb-10">
            <p class="text-slate-600 dark:text-warm-300 text-[15px] leading-relaxed">{data.excerpt}</p>
          </div>
        </div>

        {toc.length >= 3 && (
          <div class="reveal" style="transition-delay: 0.19s">
            <nav aria-label="Table of contents" class="not-prose bg-cream dark:bg-warm-700/40 border border-slate-200/60 dark:border-warm-600 rounded-xl px-5 py-4 mb-10">
              <p class="text-xs font-semibold tracking-[0.12em] uppercase text-slate-500 dark:text-warm-400 mb-2.5">In this article</p>
              <ol class="space-y-1.5 text-sm">
                {toc.map((item) => (
                  <li>
                    <a href={`#${item.id}`} class="text-slate-600 dark:text-warm-300 hover:text-teal-700 dark:hover:text-teal-400 transition-colors">
                      {item.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          </div>
        )}

        <div class="reveal" style="transition-delay: 0.2s">
          <div class="prose prose-slate dark:prose-invert max-w-none mb-12">
            <Content />
          </div>
        </div>

        {(prevPost || nextPost) && (
          <nav aria-label="More articles" class="grid sm:grid-cols-2 gap-4 mb-12 reveal" style="transition-delay: 0.22s">
            {prevPost ? (
              <a href={`/blog/${prevPost.id}/`} class="group bg-white dark:bg-warm-800 rounded-xl p-5 border border-slate-200/60 dark:border-warm-600 hover:border-teal-200/80 dark:hover:border-teal-600/80 hover:shadow-premium transition-all duration-300">
                <span class="text-xs text-slate-400 dark:text-warm-500 flex items-center gap-1.5 mb-2">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7" /><path d="M19 12H5" /></svg>
                  Previous article
                </span>
                <span class="font-medium text-slate-900 dark:text-warm-100 text-sm line-clamp-2 leading-snug group-hover:text-teal-800 dark:group-hover:text-teal-400 transition-colors">{prevPost.data.title}</span>
              </a>
            ) : <span />}
            {nextPost ? (
              <a href={`/blog/${nextPost.id}/`} class="group bg-white dark:bg-warm-800 rounded-xl p-5 border border-slate-200/60 dark:border-warm-600 hover:border-teal-200/80 dark:hover:border-teal-600/80 hover:shadow-premium transition-all duration-300 sm:text-right">
                <span class="text-xs text-slate-400 dark:text-warm-500 flex items-center gap-1.5 mb-2 sm:justify-end">
                  Next article
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
                </span>
                <span class="font-medium text-slate-900 dark:text-warm-100 text-sm line-clamp-2 leading-snug group-hover:text-teal-800 dark:group-hover:text-teal-400 transition-colors">{nextPost.data.title}</span>
              </a>
            ) : <span />}
          </nav>
        )}

        <div class="reveal" style="transition-delay: 0.25s">
          <div class="bg-linear-to-br from-teal-50/80 to-emerald-50/40 dark:from-teal-900/30 dark:to-emerald-900/20 rounded-xl p-6 sm:p-7 border border-teal-100/50 dark:border-teal-800/50 mb-12">
            <div class="flex items-start gap-4">
              <div class="w-14 h-14 bg-teal-100 dark:bg-teal-800/60 border border-teal-200 dark:border-teal-700 rounded-full flex items-center justify-center shrink-0">
                <span class="text-teal-700 dark:text-teal-400 font-bold text-lg">AD</span>
              </div>
              <div>
                <h3 class="font-heading text-base font-semibold text-slate-900 dark:text-warm-100 mb-1">About {doctor.name}</h3>
                <p class="text-slate-600 dark:text-warm-300 text-sm leading-relaxed mb-3">
                  Dr. Arpita Dash is a Dental Surgeon & Smile Specialist with {doctor.experience} years of experience in Bhubaneswar, specializing in root canal treatment, orthodontics, dental implants, and aesthetic dentistry. She has treated over {doctor.patients} patients with a 4.9-star rating.
                </p>
                <p class="text-slate-500 dark:text-warm-400 text-xs leading-relaxed mb-3">
                  {clinicInfo.name} — {clinicInfo.address} ·
                  <a href={clinicInfo.phoneLink} class="text-teal-700 dark:text-teal-400 hover:underline">{clinicInfo.phone}</a>
                </p>
                <a href="/about/" class="inline-flex items-center gap-1.5 text-teal-700 dark:text-teal-400 font-medium text-sm hover:gap-2.5 transition-all duration-300">
                  Learn more about Dr. Arpita Dash
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="reveal" style="transition-delay: 0.3s">
          <div class="bg-teal-50/60 dark:bg-teal-900/20 rounded-xl p-6 sm:p-7 border border-teal-100/60 dark:border-teal-800/60 mb-12">
            <h3 class="font-heading text-lg font-semibold text-slate-900 dark:text-warm-100 mb-2">Need Professional Advice?</h3>
            <p class="text-slate-600 dark:text-warm-300 text-[15px] mb-5 leading-relaxed">Schedule a consultation with Dr. Arpita Dash to discuss your dental concerns.</p>
            <a href="/contact/" class="inline-flex items-center gap-2 text-teal-700 dark:text-teal-400 font-medium text-sm hover:gap-3 transition-all duration-300 group">
              Book a Consultation
              <svg class="w-4 h-4 rotate-180 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7" /><path d="M19 12H5" /></svg>
            </a>
          </div>
        </div>

        {relatedPosts.length > 0 && (
          <div class="reveal" style="transition-delay: 0.4s">
            <h3 class="font-heading text-xl font-semibold text-slate-900 dark:text-warm-100 mb-5">Related Articles</h3>
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {relatedPosts.map((related) => (
                <a href={`/blog/${related.id}/`}>
                  <div class="bg-white dark:bg-warm-800 rounded-xl p-5 border border-slate-200/60 dark:border-warm-600 hover:border-teal-200/80 dark:hover:border-teal-600/80 hover:shadow-premium transition-all duration-300 shadow-premium h-full">
                    <span class="inline-block text-xs mb-2 border border-teal-200 dark:border-teal-700 text-teal-700 dark:text-teal-400 font-medium px-2 py-0.5 rounded-full">{related.category}</span>
                    <h4 class="font-medium text-slate-900 dark:text-warm-100 text-sm line-clamp-2 leading-snug">{related.title}</h4>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </article>
    </div>

  </main>
  <Footer />
</BaseLayout>

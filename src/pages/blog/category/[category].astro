---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '@/lib/format';
import { slugifyCategory, categoryMeta } from '@/lib/blog-categories';
import { SITE_URL } from '@/lib/site';
import { jsonLd } from '@/lib/json-ld';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const categories = [...new Set(posts.map((p) => p.data.category))];
  return categories.map((category) => ({
    params: { category: slugifyCategory(category) },
    props: { category, posts: posts.filter((p) => p.data.category === category) },
  }));
}

const { category, posts } = Astro.props;
const meta = categoryMeta[category] ?? { intro: '', meta: '' };
const sortedPosts = [...posts].sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const categoryPath = `/blog/category/${slugifyCategory(category)}/`;
const categoryUrl = `${SITE_URL}${categoryPath}`;
const ogImage = `${SITE_URL}/images/og/${slugifyCategory(category)}.jpg`;

const allPosts = await getCollection('blog');
const allCategories = [...new Set(allPosts.map((p) => p.data.category))].sort();

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${category} Articles`,
  itemListElement: sortedPosts.map((post, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${SITE_URL}/blog/${post.id}/`,
    name: post.data.title,
  })),
};
---

<BaseLayout
  title={`${category} Blog | YourDentist Bhubaneswar`}
  description={meta.meta}
  canonical={categoryUrl}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonLd(itemListSchema)} />
  </Fragment>
  <Header />
  <main class="flex-1 pt-36">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Blog', href: '/blog/' }, { name: category, href: categoryPath }]} />
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
      <div class="max-w-3xl mb-12 lg:mb-16 reveal">
        <span class="text-teal-700 dark:text-teal-400 font-medium text-sm tracking-[0.15em] uppercase">Blog Category</span>
        <h1 class="font-heading text-4xl sm:text-5xl font-semibold text-slate-900 dark:text-warm-100 mt-4 mb-5 tracking-tight leading-[1.1]">
          {category} <span class="text-gradient-teal">Insights</span>
        </h1>
        <p class="text-slate-500 dark:text-warm-400 text-[15px] leading-relaxed">
          {meta.intro}
        </p>
      </div>

      <div class="flex flex-wrap gap-2 mb-12 reveal">
        {allCategories.map((cat) => (
          <a
            href={`/blog/category/${slugifyCategory(cat)}/`}
            class:list={[
              'text-xs font-medium px-3 py-1.5 rounded-full border transition-colors duration-300',
              cat === category
                ? 'bg-teal-700 text-white border-teal-700 dark:bg-teal-700 dark:border-teal-600'
                : 'border-slate-200 dark:border-warm-600 text-slate-500 dark:text-warm-400 hover:border-teal-300 hover:text-teal-700 dark:hover:text-teal-400',
            ]}
          >
            {cat}
          </a>
        ))}
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedPosts.map((post, i) => (
          <div class="stagger-item" style={`transition-delay: ${Math.min(i, 8) * 0.1}s`}>
            <a href={`/blog/${post.id}/`}>
              <article class="group bg-white dark:bg-warm-800 rounded-xl overflow-hidden border border-slate-200/60 dark:border-warm-600 h-full shadow-premium hover:shadow-premium-hover hover:-translate-y-1 transition-all duration-300">
                <div class="aspect-video border-b border-slate-100 dark:border-warm-700 overflow-hidden">
                  <img
                    src={`/images/blog/${slugifyCategory(post.data.category)}.svg`}
                    alt=""
                    loading="lazy"
                    width="1200"
                    height="675"
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                </div>
                <div class="p-7">
                  <h2 class="font-heading text-lg font-semibold text-slate-900 dark:text-warm-100 mb-3 group-hover:text-teal-800 dark:group-hover:text-teal-400 transition-colors duration-300 line-clamp-2 leading-snug">{post.data.title}</h2>
                  <p class="text-slate-500 dark:text-warm-400 text-[14px] mb-5 line-clamp-3 leading-relaxed">{post.data.excerpt}</p>
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3 text-xs text-slate-500 dark:text-warm-400">
                      <span class="flex items-center gap-1">
                        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
                        {formatDate(post.data.date)}
                      </span>
                      <span class="flex items-center gap-1">
                        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                        {post.data.readTime}
                      </span>
                    </div>
                    <svg class="w-4 h-4 text-teal-700 dark:text-teal-400 opacity-0 group-hover:opacity-100 transition-all duration-300 group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
                  </div>
                </div>
              </article>
            </a>
          </div>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
